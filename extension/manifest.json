{
  "manifest_version": 3,
  "name": "Tweaks for LinkedIn (unofficial)",
  "version": "1.1.0",
  "minimum_chrome_version": "111",
  "description": "Hide clutter, filter what you see, and widen the layout on LinkedIn. Not affiliated with LinkedIn.",
  "homepage_url": "https://github.com/VatslauX/tweaks-for-linkedin",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "permissions": [
    "storage"
  ],
  "action": {
    "default_title": "Tweaks for LinkedIn (unofficial)",
    "default_popup": "options.html",
    "default_icon": {
      "16": "icons/grey16.png",
      "32": "icons/grey32.png",
      "48": "icons/grey48.png",
      "128": "icons/grey128.png"
    }
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://www.linkedin.com/*"
      ],
      "css": [
        "styles/everywhere.css",
        "styles/home.css",
        "styles/network.css"
      ],
      "js": [
        "flags.js",
        "promoted.js",
        "degree.js",
        "company.js",
        "content.js"
      ],
      "run_at": "document_start"
    }
  ]
}
