{
  "name": "tweaks-for-linkedin",
  "version": "1.0.0",
  "description": "Unofficial Chrome extension that hides clutter and filters what you see on LinkedIn.",
  "license": "Apache-2.0",
  "author": "Tweaks for LinkedIn contributors",
  "homepage": "https://github.com/VatslauX/tweaks-for-linkedin#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/VatslauX/tweaks-for-linkedin.git"
  },
  "bugs": {
    "url": "https://github.com/VatslauX/tweaks-for-linkedin/issues"
  },
  "scripts": {
    "build": "node scripts/build.js",
    "badges": "node scripts/badges.js",
    "test": "npm run lint && npm run test:unit && npm run test:integration && npm run test:e2e",
    "test:unit": "node --test tests/unit/*.test.js",
    "test:integration": "node --test tests/integration/*.test.js",
    "test:e2e": "playwright test",
    "lint": "eslint ."
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.65.1",
    "badgen": "^3.3.2",
